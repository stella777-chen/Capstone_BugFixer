{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cantier.demo/schemas/ui-config-v4.json",
  "title": "UIConfigV4",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "children", "queries"],
  "properties": {
    "type": { "const": "MesPage" },
    "title": { "type": "string" },
    "queries": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 12,
      "additionalProperties": {
        "$ref": "https://cantier.demo/schemas/query-api-v1.json"
      },
      "description": "Map of queryKey -> QueryAPIV1. Frontend executes queries and injects values via queryKey/path bindings."
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/DashboardChild" }
    }
  },
  "$defs": {
    "DashboardChild": {
      "oneOf": [
        { "$ref": "#/$defs/DataTableCard" },
        { "$ref": "#/$defs/PieChartCard" },
        { "$ref": "#/$defs/BarChartCard" },
        { "$ref": "#/$defs/LineChartCard" },
        { "$ref": "#/$defs/ComboChartCard" },
        { "$ref": "#/$defs/ScrapRateDonutCard" },
        { "$ref": "#/$defs/ReworkRateDonutCard" }
      ]
    },

    "ValueRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryKey"],
      "properties": {
        "queryKey": {
          "type": "string",
          "description": "Key of a query defined in top-level queries"
        },
        "path": {
          "type": "string",
          "description": "Path into query response, e.g. data.value"
        },
        "fallback": {
          "type": ["string", "number", "null"],
          "description": "Fallback if value is missing"
        }
      }
    },

    "DataTableValuesV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pending": {
          "oneOf": [
            { "type": "number" },
            { "$ref": "#/$defs/ValueRefV1" }
          ]
        },
        "inProgress": {
          "oneOf": [
            { "type": "number" },
            { "$ref": "#/$defs/ValueRefV1" }
          ]
        },
        "cancelled": {
          "oneOf": [
            { "type": "number" },
            { "$ref": "#/$defs/ValueRefV1" }
          ]
        },
        "closed": {
          "oneOf": [
            { "type": "number" },
            { "$ref": "#/$defs/ValueRefV1" }
          ]
        }
      }
    },

    "DataTableCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "values"],
      "properties": {
        "type": { "const": "DataTable" },
        "values": { "$ref": "#/$defs/DataTableValuesV1" }
      }
    },

    "PieChartRowV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legend", "data"],
      "properties": {
        "legend": { "type": "string" },
        "data": { "type": "number" },
        "color": {
          "type": "string",
          "description": "Optional visual override for this slice. Only include when the user explicitly requests a specific color; otherwise omit and let the frontend use its default palette."
        }
      }
    },

    "PieChartDataRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryKey", "labelField", "valueField"],
      "properties": {
        "queryKey": { "type": "string" },
        "path": {
          "type": "string",
          "description": "Path to rows array, default expected data.rows"
        },
        "labelField": { "type": "string" },
        "valueField": { "type": "string" },
        "colorField": {
          "type": "string",
          "description": "Optional field containing per-row colors. Only include when the query response provides meaningful color values or the user explicitly requests color mapping; otherwise omit."
        }
      }
    },

    "PieChartCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "chartData"],
      "properties": {
        "type": { "const": "PieChart" },
        "headerText": { "type": "string" },
        "description": { "type": "string" },
        "pieFallbackColor": {
          "type": "string",
          "description": "Optional visual override. Only include when the user explicitly requests a fallback pie slice color; otherwise omit and let the frontend use its default theme."
        },
        "chartData": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/PieChartRowV1" }
            },
            { "$ref": "#/$defs/PieChartDataRefV1" }
          ]
        }
      }
    },

    "BarChartRowV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "number" }
      }
    },

    "BarChartDataRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryKey", "nameField", "valueField"],
      "properties": {
        "queryKey": { "type": "string" },
        "path": {
          "type": "string",
          "description": "Path to rows array, default expected data.rows"
        },
        "nameField": { "type": "string" },
        "valueField": { "type": "string" }
      }
    },

    "BarChartCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "chartData"],
      "properties": {
        "type": { "const": "BarChart" },
        "headerText": { "type": "string" },
        "description": { "type": "string" },
        "barColor": {
          "type": "string",
          "description": "Optional visual override. Only include when the user explicitly requests a specific bar color; otherwise omit and let the frontend use its default theme."
        },
        "maxLoadingTime": { "type": "number" },
        "chartData": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/BarChartRowV1" }
            },
            { "$ref": "#/$defs/BarChartDataRefV1" }
          ]
        }
      }
    },

    "LineChartRowV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "yield"],
      "properties": {
        "name": { "type": "string" },
        "yield": { "type": "number" }
      }
    },

    "LineChartDataRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryKey", "nameField", "yieldField"],
      "properties": {
        "queryKey": { "type": "string" },
        "path": {
          "type": "string",
          "description": "Path to rows array, default expected data.rows"
        },
        "nameField": { "type": "string" },
        "yieldField": { "type": "string" }
      }
    },

    "LineChartCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "chartData"],
      "properties": {
        "type": { "const": "LineChart" },
        "headerText": { "type": "string" },
        "description": { "type": "string" },
        "lineColor": {
          "type": "string",
          "description": "Optional visual override. Only include when the user explicitly requests a specific line color; otherwise omit and let the frontend use its default theme."
        },
        "maxLoadingTime": { "type": "number" },
        "chartData": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/LineChartRowV1" }
            },
            { "$ref": "#/$defs/LineChartDataRefV1" }
          ]
        }
      }
    },

    "ComboChartRowV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "barValue", "lineValue"],
      "properties": {
        "name": { "type": "string" },
        "barValue": { "type": "number" },
        "lineValue": { "type": "number" }
      }
    },

    "ComboChartDataRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryKey", "nameField", "barField", "lineField"],
      "properties": {
        "queryKey": { "type": "string" },
        "path": {
          "type": "string",
          "description": "Path to rows array, default expected data.rows"
        },
        "nameField": { "type": "string" },
        "barField": { "type": "string" },
        "lineField": { "type": "string" }
      }
    },

    "ComboChartCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "chartData"],
      "properties": {
        "type": { "const": "ComboChart" },
        "headerText": { "type": "string" },
        "description": { "type": "string" },
        "barColor": {
          "type": "string",
          "description": "Optional visual override. Only include when the user explicitly requests a specific combo chart bar color; otherwise omit and let the frontend use its default theme."
        },
        "lineColor": {
          "type": "string",
          "description": "Optional visual override. Only include when the user explicitly requests a specific combo chart line color; otherwise omit and let the frontend use its default theme."
        },
        "lineTotalValue": { "type": "number" },
        "totalCount": { "type": "number" },
        "chartData": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/ComboChartRowV1" }
            },
            { "$ref": "#/$defs/ComboChartDataRefV1" }
          ]
        }
      }
    },

    "DonutLegendNamesV1": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string" }
    },

    "DonutCardBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rate", "count"],
      "properties": {
        "type": { "type": "string" },
        "headerText": { "type": "string" },
        "description": { "type": "string" },
        "rate": {
          "oneOf": [
            { "type": "number" },
            { "$ref": "#/$defs/ValueRefV1" }
          ]
        },
        "count": {
          "oneOf": [
            { "type": "number" },
            { "$ref": "#/$defs/ValueRefV1" }
          ]
        },
        "totalValue": { "type": "number" },
        "filledColor": {
          "type": "string",
          "description": "Optional visual override. Only include when the user explicitly requests a specific filled donut color; otherwise omit and let the frontend use its default theme."
        },
        "backgroundColor": {
          "type": "string",
          "description": "Optional visual override. Only include when the user explicitly requests a specific donut background color; otherwise omit and let the frontend use its default theme."
        },
        "legendNames": { "$ref": "#/$defs/DonutLegendNamesV1" },
        "className": { "type": "string" },
        "maxLoadingTime": { "type": "number" }
      }
    },

    "ScrapRateDonutCard": {
      "allOf": [
        { "$ref": "#/$defs/DonutCardBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "ScrapRateDonut" }
          }
        }
      ]
    },

    "ReworkRateDonutCard": {
      "allOf": [
        { "$ref": "#/$defs/DonutCardBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "ReworkRateDonut" }
          }
        }
      ]
    }
  }
}
